# Brevo: use smtp-relay.sendinblue.com (the smtp-relay.brevo.com cert is currently broken)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
ALERT_FROM=you@gmail.com
ALERT_TO=you@gmail.com

# optional: lets the digest carry a "watched room updated / back" section.
# FAVS_KEY is the same passphrase you set as FAVS_KEY in Vercel for the dashboard.
FAVS_API=https://www.caleta.tech/api/favs
FAVS_KEY=your-favourites-passphrase
